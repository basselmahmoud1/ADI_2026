# ============================================================
# FFT Project .gitignore
# ============================================================

# --- QuestaSim / ModelSim compiled library (work dir) ---
UVM_TB/sim/work/
UVM_TB/sim/work

# --- Simulation runtime artifacts ---
UVM_TB/sim/runs_outputs/
UVM_TB/sim/*.ucdb
UVM_TB/sim/*.log
UVM_TB/sim/*.wlf
UVM_TB/sim/*.wdb
UVM_TB/sim/transcript
UVM_TB/sim/modelsim.ini
UVM_TB/sim/.modelsim

# --- Simulation input/output text files (generated per run) ---
UVM_TB/sim/fft_in.txt
UVM_TB/sim/fft_out_ref.txt
UVM_TB/sim/dut_out.txt

# --- Coverage reports (generated by vcover) ---
UVM_TB/sim/cov_report/
UVM_TB/sim/reports/
UVM_TB/sim/coverage_report.txt
UVM_TB/sim/coverage_summary.txt

# --- MATLAB compiled MEX binaries ---
matlab_model/*.mexw64
matlab_model/*.mexw32
matlab_model/*.mex*

# --- MATLAB codegen / fiaccel / instrumentation artifacts ---
matlab_model/fiaccel/
matlab_model/instrumentation/
matlab_model/codegen/
